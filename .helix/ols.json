{
  "$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
  "collections": [],
  "enable_semantic_tokens": true,
  "enable_document_symbols": true,
  "enable_hover": true,
  "enable_snippets": true,
  "profile": "default",
  "profiles": [
    {
      "name": "default",
      "checker_path": [
        "src"
      ],
      "defines": {
        "ODIN_DEBUG": "false"
      }
    },
    {
      "name": "linux_profile",
      "os": "linux",
      "checker_path": [
        "src"
      ],
      "defines": {
        "ODIN_DEBUG": "false"
      }
    }
  ]
}